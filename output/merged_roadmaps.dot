      "n1441" [label="Minimize network latency by hosting your backend close to your users", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1442" [label="Utilize HTTP keep-alive to reduce connection overhead", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1443" [label="Use CDNs for static and frequently accessed assets", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1444" [label="Prefetch or preload resources, data, or dependencies needed for subsequent requests to minimize latency", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
    }
    subgraph "cluster_backend_performance_best_practices_ck_9" { label=""; style="dashed"; color="#43a047";
