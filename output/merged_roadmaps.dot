    subgraph "cluster_api_security_best_practices_ck_0" { label=""; style="dashed"; color="#43a047";
      "n1349" [label="Audit your design and implementation with unit/integration tests", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1350" [label="Use a code review process and disregard self-approval", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1351" [label="Continuously run security analysis on your code", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1352" [label="Check your dependencies for known vulnerabilities", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1353" [label="Design a rollback solution for deployments", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
    }
    subgraph "cluster_api_security_best_practices_ck_1" { label=""; style="dashed"; color="#43a047";
      "n1354" [label="Send X-Content-Type-Options: nosniff header", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1355" [label="Send X-Frame-Options: deny header", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1356" [label="Send Content-Security-Policy: default-src 'none' header", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1357" [label="Remove fingerprinting headers (e.g. x-powered-by)", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1358" [label="Force content-type for your response", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1359" [label="Avoid returning sensitive data (credentials, tokens, etc)", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1360" [label="Return proper response codes as per the operation", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
    }
    subgraph "cluster_api_security_best_practices_ck_2" { label=""; style="dashed"; color="#43a047";
      "n1361" [label="Use centralized logins for all services and components", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1362" [label="Use agents to monitor all requests, responses, and errors", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1363" [label="Use alerts for SMS, Slack, Email, Kibana, CloudWatch, etc", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1364" [label="Ensure you aren’t logging any sensitive data", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1365" [label="Use an IDS and/or IPS system to monitor everything", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
    }
    subgraph "cluster_api_security_best_practices_ck_3" { label=""; style="dashed"; color="#43a047";
      "n1366" [label="Limit requests (throttling) to avoid DDoS / brute force", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1367" [label="Use HTTPS on server side and secure ciphers", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1368" [label="Use HSTS header with SSL to avoid SSL strip attacks", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1369" [label="Turn off directory listings", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1370" [label="Private APIs should only be accessible from safe-listed IPs", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
    }
    subgraph "cluster_api_security_best_practices_ck_4" { label=""; style="dashed"; color="#43a047";
      "n1371" [label="Use good JWT Secret to make brute-force attacks difficult", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1372" [label="Do not extract the algorithm from the header, use backend", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1373" [label="Make token expiration (TTL, RTTL) as short as possible", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1374" [label="Avoid storing sensitive data in JWT payload", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1375" [label="Keep the payload small to reduce the size of the JWT", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
    }
    subgraph "cluster_api_security_best_practices_ck_5" { label=""; style="dashed"; color="#43a047";
      "n1376" [label="Always validate redirect_uri on server-side", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1377" [label="Avoid response_type=token and try to exchange for code", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1378" [label="Use state parameter to prevent CSRF attacks", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1379" [label="Have default scope, and validate scope for each application", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
    }
    subgraph "cluster_api_security_best_practices_ck_6" { label=""; style="dashed"; color="#43a047";
      "n1380" [label="Check if all endpoints are protected behind authentication to avoid broken authentication process", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1381" [label="Avoid user’s personal ID in resource URLs (e.g., users/242/orders)", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1382" [label="Prefer using UUID over auto-increment IDs", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1383" [label="Disable entity parsing if parsing XML to avoid XXE attacks", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1384" [label="Disable entity expansion if using XML, YAML, or similar", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1385" [label="Use a CDN for file uploads", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1386" [label="Avoid HTTP blocking when handling large amounts of data", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1387" [label="Make sure debug mode is off in production", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1388" [label="Use non-executable stacks when available", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
    }
    subgraph "cluster_api_security_best_practices_ck_7" { label=""; style="dashed"; color="#43a047";
      "n1389" [label="Limit requests (throttling) to avoid DDoS / brute force", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1390" [label="Use HTTPS on server side and secure ciphers", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1391" [label="Use HSTS header with SSL to avoid SSL strip attacks", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
