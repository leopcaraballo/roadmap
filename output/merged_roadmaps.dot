      "n1393" [label="Private APIs should only be accessible from safe-listed IPs", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
    }
    subgraph "cluster_api_security_best_practices_ck_8" { label=""; style="dashed"; color="#43a047";
      "n1394" [label="Avoid ‘Basic Authentication’, use standard (e.g. JWT)", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
