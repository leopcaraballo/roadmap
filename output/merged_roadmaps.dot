  subgraph "cluster_aws_best_practices" {
    label="AWS · aws-best-practices"; fontsize=20; style="rounded"; color="#555555";
    "n1234" [label="Find the detailed version of this roadmap along with other similar roadmaps", fillcolor="#ffffff", color="#9e9e9e", fontcolor="#000000"];
    "n1235" [label="roadmap.sh", fillcolor="#4136d6", color="#4136d6", fontcolor="#ffffff"];
    "n1236" [label="AWS", fillcolor="#ffffff", color="#ffffff", fontcolor="#000000", fontsize=16, penwidth=0];
    "n1237" [label="Continue Learning with following relevant tracks", fillcolor="#ffffff", color="#9e9e9e", fontcolor="#000000"];
    "n1238" [label="Backend Roadmap", fillcolor="#4136d6", color="#4136d6", fontcolor="#ffffff"];
    "n1239" [label="DevOps Roadmap", fillcolor="#4136d6", color="#4136d6", fontcolor="#ffffff"];
    subgraph "cluster_aws_best_practices_ck_0" { label=""; style="dashed"; color="#43a047";
      "n1240" [label="Terminate SSL on the load balancer", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1241" [label="Pre-warm your ELBs if you're expecting heavy traffic", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
    }
    subgraph "cluster_aws_best_practices_ck_1" { label=""; style="dashed"; color="#43a047";
      "n1242" [label="Assign tags to everything", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1243" [label="Use termination protection for non-auto-scaling instances", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1244" [label="Use a VPC", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1245" [label="Use reserved instances to save big $$$", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1246" [label="Lock down your security groups", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1247" [label="Don't keep unassociated Elastic IPs", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
    }
    subgraph "cluster_aws_best_practices_ck_2" { label=""; style="dashed"; color="#43a047";
      "n1248" [label="Use CLI tools", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1249" [label="Use the free metrics", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1250" [label="Use the custom metrics", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1251" [label="Use detailed monitoring", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
    }
    subgraph "cluster_aws_best_practices_ck_3" { label=""; style="dashed"; color="#43a047";
      "n1252" [label="Prefer EC2 roles over app level IAM account", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1253" [label="Assign permissions to groups, not users", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1254" [label="Set up automated security auditing", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1255" [label="Use CloudTrail to keep an audit log", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1256" [label="Apply least-privilege permissions", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
    }
    subgraph "cluster_aws_best_practices_ck_4" { label=""; style="dashed"; color="#43a047";
      "n1257" [label="Use \"-\" instead of \".\" in bucket names for SSL", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1258" [label="Avoid filesystem mounts (FUSE, etc)", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1259" [label="Having CloudFront in front of S3 is optional (but it can help)", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1260" [label="Use random strings at the start of your keys", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
    }
    subgraph "cluster_aws_best_practices_ck_5" { label=""; style="dashed"; color="#43a047";
      "n1261" [label="Set up granular billing alerts", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
    }
    subgraph "cluster_aws_best_practices_ck_6" { label=""; style="dashed"; color="#43a047";
      "n1262" [label="Do not store application state on servers", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1263" [label="Store extra information in your logs", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1264" [label="If you need to interact with AWS, use the official SDK", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1265" [label="Have tools to view application logs", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
    }
    subgraph "cluster_aws_best_practices_ck_7" { label=""; style="dashed"; color="#43a047";
      "n1266" [label="Use IAM roles", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1267" [label="Use multiple API keys for different purposes", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1268" [label="Use multi-factor auth for IAM users", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
    }
    subgraph "cluster_aws_best_practices_ck_8" { label=""; style="dashed"; color="#43a047";
      "n1269" [label="Use ALIAS records", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
    }
    subgraph "cluster_aws_best_practices_ck_9" { label=""; style="dashed"; color="#43a047";
      "n1270" [label="Specify a directory on S3 for Hive results", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
    }
    subgraph "cluster_aws_best_practices_ck_10" { label=""; style="dashed"; color="#43a047";
      "n1271" [label="Use configuration endpoints over individual endpoints", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
    }
    subgraph "cluster_aws_best_practices_ck_11" { label=""; style="dashed"; color="#43a047";
      "n1272" [label="Scale down on INSUFFICIENT_DATA as well as ALARM", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1273" [label="Use ELB health check instead of EC2 health checks", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1274" [label="Only use the availability zones (AZs) your ELB is configured for", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
      "n1275" [label="Avoid multiple scaling triggers on the same group", fillcolor="#e8f5e9", color="#43a047", fontcolor="#000000"];
    }
    subgraph "cluster_aws_best_practices_ck_12" { label=""; style="dashed"; color="#43a047";
